# HTTP port used by the Express server.
PORT=4000
# File path for the SQLite database.
SQLITE_PATH=./bookmyshow-dev.db
# Development-only signing secret; replace in production.
JWT_SIGNING_SECRET=dev-secret-change-in-production
# Browser origin allowed to call the API during local development.
CORS_ORIGIN=http://127.0.0.1:3000
# Application logging threshold.
LOG_LEVEL=info
